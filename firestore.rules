rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function memberOf(cid) { return signedIn() && request.auth.uid in get(/databases/$(db)/documents/chats/$(cid)).data.members; }

    // פרופילים: כל משתמש מחובר רואה; רק אתה עורך את שלך (בלי לשנות לעצמך את כוכבי העזרה);
    // אחרים יכולים רק להוסיף לך כוכב עזרה אחד בכל פעם
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.get('stars', 0) == 0 && request.resource.data.get('banned', false) == false;
      allow update: if signedIn() && (
        isAdmin()
        || (request.auth.uid == uid && request.resource.data.get('stars', 0) == resource.data.get('stars', 0) && request.resource.data.get('banned', false) == resource.data.get('banned', false))
        || (request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars'])
            && request.resource.data.stars == resource.data.get('stars', 0) + 1));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // צ׳אטים: רק שני המשתתפים רואים וכותבים
    match /classes/{code} {
      allow read, write: if signedIn();
    }
    match /chats/{cid} {
      allow read: if isAdmin() || (signedIn() && (resource == null || request.auth.uid in resource.data.members));
      allow create: if signedIn() && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members;
      match /messages/{mid} {
        allow read: if memberOf(cid);
        allow create: if memberOf(cid) && request.resource.data.from == request.auth.uid
                      && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      }
    }

    // מנהלים: נקבעים רק מתוך קונסולת Firebase
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // דירוגי האפליקציה: כל אחד רואה, כל משתמש כותב רק את הדירוג שלו
    match /ratings/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.stars is int
                   && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
                   && request.resource.data.get('text', '').size() <= 400;
    }

    // מילים טובות על עזרה: כל אחד רואה, כותבים רק בשם עצמך
    match /thanks/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.to is string
                    && request.resource.data.text is string && request.resource.data.text.size() <= 140;
    }

    // דיווחים: כל משתמש יכול לדווח, רק מנהלים רואים ומטפלים
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.reason is string;
      allow read, update: if isAdmin();
    }

    // רעיונות לשיפור: כל משתמש שולח, רק מנהלים קוראים
    match /ideas/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow read, update: if isAdmin();
    }

    // שיחות וידאו (רק נתוני חיבור, הווידאו עצמו לא עובר כאן)
    match /calls/{cid} {
      allow read, write: if memberOf(cid);
      match /{role}/{doc} {
        allow read, write: if memberOf(cid);
      }
    }

    // עזרה נקודתית: כל משתמש מבקש; מי שיכול לעזור "לוקח" בקשה פתוחה אחת בלבד
    match /quick/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 200;
      allow update: if signedIn() && (resource.data.by == request.auth.uid
        || (resource.data.status == 'open' && request.resource.data.status == 'taken' && request.resource.data.takenBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','takenBy','takenByName'])));
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // קבוצות לימוד: כל משתמש רואה ומצטרף; חברים כותבים הודעות, מסמני נוכחות ולוח ציור
    function gMember(gid) { return signedIn() && request.auth.uid in get(/databases/$(db)/documents/groups/$(gid)).data.members; }
    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid && request.resource.data.members.size() == 1 && request.resource.data.max <= 6;
      allow update: if signedIn() && (resource.data.hostId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names','live']) && request.resource.data.members.size() <= resource.data.max
           && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members));
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
      match /messages/{mid} {
        allow read: if gMember(gid);
        allow create: if gMember(gid) && request.resource.data.from == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
      match /sig/{doc} {
        allow read, write: if gMember(gid);
      }
      match /board/{doc} {
        allow read, write: if gMember(gid);
      }
    }
  }
}
